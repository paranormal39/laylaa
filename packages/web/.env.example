# Layla NFT Shop — Web dApp environment
# Copy to .env and fill in values as needed.

# ============================================
# CONTRACT ADDRESSES (your deployed Midnight contracts)
# ============================================
# Override auto-joined contracts. Leave blank to use defaults.
VITE_NFT_ADDRESS=
VITE_BRIDGE_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
VITE_COLLECTION_ADDRESS=

# ============================================
# MIDNIGHT NETWORK & PROOF SERVER
# ============================================
# Network: preview | preprod | standalone (default: preview)
VITE_MIDNIGHT_NETWORK=preview
# Proof server URL for transaction proving (default: http://127.0.0.1:6300)
VITE_PROOF_SERVER=http://127.0.0.1:6300

# ============================================
# XRPL INTEGRATION
# ============================================
# Bithomp API key for live XRPL mainnet trending feed (optional; falls back to sample data)
VITE_BITHOMP_API_KEY=your-bithomp-api-key

# Treasury address for token pay-to-mint (must match backend TREASURY_ADDRESS)
VITE_TREASURY_ADDRESS=rTreasuryAddress...