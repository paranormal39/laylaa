# Xaman (XUMM) API credentials — create an app at https://apps.xaman.dev
# The SECRET must stay on the server; never expose it to the browser.
XUMM_API_KEY=your-xumm-api-key
XUMM_API_SECRET=your-xumm-api-secret

# Server config
PORT=4000
# Public URL of this service (used to build absolute URLs for local image uploads).
# In Railway set this to https://<your-app>.up.railway.app
PUBLIC_URL=https://your-app.up.railway.app
# Comma-separated list of allowed CORS origins (the web dApp dev server)
CORS_ORIGINS=http://localhost:5173

# XRPL testnet server-side mint wallet (generate a testnet wallet and fund it via faucet)
TESTNET_MINT_SEED=snTestNetSecret...

# Treasury address for token pay-to-mint (where users send tokens)
TREASURY_ADDRESS=rTreasury...

# IPFS storage via Pinata (https://app.pinata.cloud → API Keys → New Key → copy the JWT).
# If PINATA_JWT is unset, uploads fall back to non-durable local storage.
PINATA_JWT=your-pinata-jwt
# Optional dedicated gateway (defaults to https://gateway.pinata.cloud)
