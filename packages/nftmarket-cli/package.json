{
  "name": "@nftmarket/cli",
  "version": "1.0.0",
  "description": "NFT Marketplace CLI for testing smart contracts and integrations",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "nftmarket": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "preview": "tsx src/index.ts preview",
    "preprod": "tsx src/index.ts preprod",
    "testnet": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nftmarket/nft-contract": "*",
    "@nftmarket/bridge-contract": "*",
    "@nftmarket/marketplace-contract": "*",
    "@nftmarket/collection-contract": "*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "enquirer": "^2.4.1",
    "ora": "^8.0.1",
    "xrpl": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
